{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The deployed Worker that owns the exmonitor.extem.net custom domain.
  // Renaming it here would detach that domain, so the name stays.
  "name": "ex-monitor-downloads",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "RelayRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayRoom"]
    }
  ],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}