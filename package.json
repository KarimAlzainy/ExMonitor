{
  "name": "ex-monitor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import ./scripts/register-wasm-rollup.mjs ./node_modules/vite/bin/vite.js --host",
    "build": "tsc -b && node --import ./scripts/register-wasm-rollup.mjs ./node_modules/vite/bin/vite.js build",
    "preview": "node --import ./scripts/register-wasm-rollup.mjs ./node_modules/vite/bin/vite.js preview --host",
    "relay": "node server.js --relay-only --port 8080",
    "start": "node server.js",
    "package:bundles": "node scripts/package-bundles.mjs",
    "site:dev": "npx wrangler dev",
    "site:deploy": "npx wrangler deploy"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.88",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.68.3",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^0.21.1"
  }
}
